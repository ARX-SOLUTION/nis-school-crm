# Vite-exposed env vars must be VITE_*
# Local dev default. For Cloudflare deploy, set an absolute new API domain
# at build time, e.g. VITE_API_URL=https://api.example.com/api/v1
# (Vite inlines this during `vite build`; relative '/api/v1' only works
# when frontend and API share one origin via Caddy).
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=NIS School CRM
# Telegram bot username (without @). Leave empty to use the dev payload fallback.
VITE_TELEGRAM_BOT_USERNAME=
